# ShopSphere monorepo .gitignore
# Commit: pnpm-lock.yaml, uv.lock, .nvmrc, .python-version, every .env.example, docs/course/*

# ---------------------------------------------------------------- dependencies
node_modules/
.pnpm-store/
.pnp
.pnp.*
.venv/
venv/

# ---------------------------------------------------------------- build output and caches
dist/
dist-ssr/
build/
out/
.next/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts                # regenerated by `next dev` / `next build`
.eslintcache
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------- environment and secrets
# Real settings live in .env files (services/*/.env, infra/docker/.env). Commit only the examples.
.env
.env.*
!.env.example
*.local
secrets/                     # Compose secrets folder (Docker book, Chapter 10)
*.pem
*.key
*.p12
*.pfx
*.crt                        # local TLS certificates (mkcert)

# ---------------------------------------------------------------- Docker
compose.override.yaml        # personal Compose tweaks (extra ports, GPU for Ollama...)
compose.override.yml
docker-compose.override.yml

# ---------------------------------------------------------------- logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------- testing
coverage/
playwright-report/
blob-report/
test-results/
playwright/.cache/
tests/load/results/          # k6 summaries you generate locally

# ---------------------------------------------------------------- Terraform (commit .terraform.lock.hcl and *.tf)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
secret.tfvars

# ---------------------------------------------------------------- OS / editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.suo
*.sln

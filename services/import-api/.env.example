# Copy to .env for local development. In AWS, ECS / Kubernetes inject these.
APP_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=import-api
PORT=8001

# Uncomment as you build the service (and add the field to settings.py):
# DATABASE_URL=postgresql://shop:shop_dev_pw@localhost:5432/shopsphere
# Local SeaweedFS (docker compose --profile files). For Cloudflare R2 use
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto" and an R2 API token.
# S3_ENDPOINT=http://localhost:8333
# S3_PUBLIC_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=shopsphere
# S3_SECRET_ACCESS_KEY=shopsphere_dev_secret
# S3_IMPORTS_BUCKET=imports

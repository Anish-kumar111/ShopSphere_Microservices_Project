# Copy to .env for local development. In AWS, ECS / Kubernetes inject these (secrets from Secrets Manager).
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=bff
PORT=4000

# Uncomment as you build the service (and add the key to src/config/env.ts):
# AUTH_URL=http://localhost:4001
# USER_URL=http://localhost:4002
# ORDER_URL=http://localhost:4003
# IMPORT_URL=http://localhost:8001

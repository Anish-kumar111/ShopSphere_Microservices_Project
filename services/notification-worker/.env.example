# Copy to .env for local development. In AWS, ECS / Kubernetes inject these (secrets from Secrets Manager).
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=notification-worker
HEALTH_PORT=9101

# Uncomment as you build the service (and add the key to src/config/env.ts):
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# REDIS_URL=redis://localhost:6379
# SMTP_URL=smtp://localhost:1025

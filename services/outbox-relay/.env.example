# Copy to .env for local development. In AWS, ECS / Kubernetes inject these (secrets from Secrets Manager).
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=outbox-relay
HEALTH_PORT=9100

# Uncomment as you build the service (and add the key to src/config/env.ts):
# DATABASE_URL=postgres://shop:shop_dev_pw@localhost:5432/shopsphere
# KAFKA_BROKERS=localhost:9092
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

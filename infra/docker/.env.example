# Copy to infra/docker/.env to override docker-compose.yml defaults. Compose reads it automatically.
# .env is git-ignored: real keys (e.g. Cloudflare R2) are safe there, never in docker-compose.yml.

# Profiles to start by default with a plain `docker compose up -d` (comma-separated):
# COMPOSE_PROFILES=events,files

# ---------------------------------------------------------------- database
# Keep in sync with DATABASE_URL in the services' .env files.
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_dev_pw
POSTGRES_DB=shopsphere

# Host ports. Change them if PostgreSQL / MongoDB / Redis are also installed natively on your PC
# ("ports are not available" error), and use the same port in the services' DATABASE_URL / MONGO_URL.
# Containers always talk to each other on the default ports, so only your PC-side URLs change.
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379

# ---------------------------------------------------------------- object storage
# Default: local SeaweedFS (nothing to set). To use Cloudflare R2 instead, uncomment and fill in:
#   Dashboard -> R2 -> Manage API tokens -> "Object Read & Write" token, scoped to your buckets.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<r2 access key id>
# S3_SECRET_ACCESS_KEY=<r2 secret access key>
# S3_IMPORTS_BUCKET=shopsphere-imports-dev
# S3_INVOICES_BUCKET=shopsphere-invoices-dev
# Then create the buckets, CORS and lifecycle rules on R2 with:
#   docker compose run --rm --no-deps storage-init
